{
    "name": "Tic-Tac-Toe Django",

    // Use docker-compose to start both Django and MariaDB
    "dockerComposeFile": ["../docker-compose.yml", "docker-compose.dev.yml"],
    "service": "tictactoe-0",
    "shutdownAction": "stopCompose",

    // Run VS Code Server as root so it has a writable home directory (/root).
    // The development stage has no dedicated non-root user; without this VS Code
    // picks up the system user created in the production stage (home=/nonexistent).
    "remoteUser": "root",

    // Mount the workspace into the container working directory
    "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind,consistency=cached",
    "workspaceFolder": "/app",

    // Keep the container alive — start the dev server manually in the terminal:
    //   python manage.py runserver 0.0.0.0:8000
    "overrideCommand": true,

    // Sync dependencies after the workspace bind-mount replaces /app
    "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",

    // Forward Django dev server port to the host
    "forwardPorts": [8000],
    "portsAttributes": {
        "8000": {
            "label": "Django Dev Server",
            "onAutoForward": "notify"
        }
    },

    // VS Code extensions and settings applied inside the container
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.pylint",
                "ms-python.black-formatter",
                "ms-python.isort",
                "batisteo.vscode-django",
                "ms-python.debugpy"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "editor.formatOnSave": true,
                "editor.rulers": [88],
                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter"
                }
            }
        }
    }
}
