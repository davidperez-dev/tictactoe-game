# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# =============================================================================

# -- Django core ---------------------------------------------------------------
# Generate with (avoids characters that break .env or Docker Compose interpolation):
#   python3 scripts/generate-secret-key.py
SECRET_KEY=change-me-to-a-long-random-string

# 1 = development, 0 = production
DEBUG=0

# Comma-separated list of valid host/domain names
ALLOWED_HOSTS=localhost,127.0.0.1

# -- Server --------------------------------------------------------------------
# Host port mapped to the container's 8000
DJANGO_PORT=8000

# Application version — returned by GET /api/health/
APP_VERSION=1.0.0

# -- Database (MariaDB) -------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root-secret
DB_NAME=django_auth_db
DB_USER=django_auth_user
DB_PASSWORD=change-me-db-secret
DB_PORT=3306

# -- CORS ----------------------------------------------------------------------
# Use * to allow all origins, or comma-separated list:
#   CORS_ORIGINS=http://myapp.example.com,http://localhost:3000
CORS_ORIGINS=*
